{
  "include": ["backend/app", "backend/tests", "backend/alembic", "mcp/app", "mcp/tests"],
  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/.pytest_cache",
    "**/node_modules",
    "frontend/.next"
  ],
  "pythonVersion": "3.12",
  "venvPath": "backend",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": ["backend"]
    },
    {
      "root": "mcp",
      "extraPaths": [
        "mcp",
        "mcp/.venv/Lib/site-packages",
        "mcp/.venv/lib/python3.12/site-packages"
      ]
    }
  ],
  "extraPaths": ["backend", "mcp"],
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none"
}
