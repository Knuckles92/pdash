# pdash Caddyfile.
#
# Reverse-proxies for the three services. Caddy listens on :443 (tls internal)
# and :80. Tailscale handles network-level identity (the box must be on your
# tailnet), so Caddy's job is just routing and (optionally) TLS.

# ---------------------------------------------------------------------------
# Shared routes (snippet).
(pdash_routes) {
    encode gzip zstd

    # Long-lived idle timeouts so SSE streams don't drop unexpectedly.
    # `flush_interval -1` makes Caddy stream the response without buffering.
    @sse path /api/v1/events /api/v1/internal/events
    handle @sse {
        reverse_proxy backend:8080 {
            flush_interval -1
            transport http {
                read_timeout 24h
            }
        }
    }

    # MCP server (streamable HTTP). Same flush + long-timeout posture.
    # This is the remote-agent entry point: devices elsewhere on the tailnet
    # connect their MCP clients to https://<host>.<tailnet>.ts.net/mcp.
    handle /mcp* {
        reverse_proxy mcp:8090 {
            flush_interval -1
            transport http {
                read_timeout 24h
            }
        }
    }

    # All other API traffic.
    handle /api/* {
        reverse_proxy backend:8080 {
            transport http {
                read_timeout 5m
            }
        }
    }

    # OpenAPI / docs.
    handle /healthz {
        reverse_proxy backend:8080
    }
    handle /readyz {
        reverse_proxy backend:8080
    }

    # Everything else → Next.js.
    handle {
        reverse_proxy frontend:3000
    }
}

# ---------------------------------------------------------------------------
# Option B — Caddy's `tls internal` (development-grade certs).
:443 {
    tls internal
    import pdash_routes
}

# Plain HTTP — Tailscale Serve already proxies; Caddy mirrors for LAN access.
:80 {
    import pdash_routes
}
